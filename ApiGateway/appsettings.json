{
  "Jwt": {
    "Key": "ECommerceSuperSecretKey123456789012345",
    "Issuer": "AuthService",
    "Audience": "ECommerce"
  },
  "ReverseProxy": {
    "Routes": {
      "product-route": {
        "ClusterId": "product-cluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "customer-route": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        }
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "product-cluster": {
        "Destinations": {
          "product-service": {
            "Address": "http://localhost:5271/"
          }
        }
      },
      "customer-cluster": {
        "Destinations": {
          "customer-service": {
            "Address": "http://localhost:5030/"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order-service": {
            "Address": "http://localhost:5127/"
          }
        }
      }
    }
  }
}